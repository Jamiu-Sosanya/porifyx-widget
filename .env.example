APP_NAME="PoriFyx Widget"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@porifyx.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"

# ─── Broadcasting / Real-time (Laravel Reverb) ───────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── PWA Push Notifications (VAPID) ─────────────────────────────
# Generate keys with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# ─── Webhooks ────────────────────────────────────────────────────
# Minimum lead score jump to trigger lead.qualified webhook
WEBHOOK_LEAD_SCORE_JUMP=10

# ─── AI Providers ────────────────────────────────────────────────
# OpenAI (default)
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq (ultra-fast open-source models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Backup provider used when a widget's provider errors: openai|anthropic|gemini|groq|openrouter
AI_FALLBACK_PROVIDER=

# ─── Payment ─────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── Error Tracking ──────────────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ─── Branding (White-label) ───────────────────────────────────────
BRAND_TAGLINE="AI chat that sells, supports and qualifies — on autopilot"
BRAND_DESCRIPTION="Train PoriFyx on your business, drop one line of code on your site, and turn every visitor conversation into a qualified lead."
BRAND_SUPPORT_EMAIL=info@porifyx.com
BRAND_SUPPORT_URL=
BRAND_DOCS_URL=
BRAND_PRIVACY_URL=
BRAND_TERMS_URL=
BRAND_SOCIAL_PROOF="2,400+"
BRAND_SOCIAL_PROOF_TEXT="businesses trust us"
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_PRIMARY_COLOR="#2f5ee8"
BRAND_TWITTER_URL=
BRAND_FACEBOOK_URL=
BRAND_LINKEDIN_URL=
BRAND_COPYRIGHT=
LANDING_PAGE_ENABLED=true

# ─── Security ─────────────────────────────────────────────────────
# Comma-separated IPs allowed to access /admin. Leave empty to allow all.
ADMIN_IP_WHITELIST=
# Enable 2FA enforcement for admin users
FORCE_2FA_ADMIN=false

# ─── Features ────────────────────────────────────────────────────
TRIAL_DAYS=14

# Demo Mode — set to true to block all write operations (read-only demo)
DEMO_MODE=false

# Installation
INSTALLATION_COMPLETE=false
